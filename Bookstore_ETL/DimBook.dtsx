          SQLTask:Connection="{F5A68F90-D520-4D6D-A375-75E5A0FCDDE4}"
          SQLTask:SqlStatementSource="IF EXISTS (SELECT 1 FROM dbo.PackageConfig WHERE ConfigurationFilter = 'DimBook')&#xA;    UPDATE dbo.PackageConfig&#xA;    SET ConfiguredValue = CAST(? AS NVARCHAR(255))&#xA;    WHERE ConfigurationFilter = 'DimBook';&#xA;ELSE&#xA;    INSERT INTO dbo.PackageConfig (ConfigurationFilter, ConfiguredValue, PackagePath, ConfiguredValueType)&#xA;    VALUES ('DimBook', CAST(? AS NVARCHAR(255)), '\Package\DimBook.dtsx', 'Int64');" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
