          SQLTask:SqlStatementSource="IF EXISTS (SELECT 1 FROM dbo.PackageConfig WHERE ConfigurationFilter = 'DimShippingMethod')&#xA;    UPDATE dbo.PackageConfig&#xA;    SET ConfiguredValue = CAST(? AS NVARCHAR(255))&#xA;    WHERE ConfigurationFilter = 'DimShippingMethod';&#xA;ELSE&#xA;    INSERT INTO dbo.PackageConfig (ConfigurationFilter, ConfiguredValue, PackagePath, ConfiguredValueType)&#xA;    VALUES ('DimShippingMethod', CAST(? AS NVARCHAR(255)), '\Package\DimShippingMethod.dtsx', 'Int64');" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
