          SQLTask:SqlStatementSource="IF EXISTS (SELECT 1 FROM dbo.PackageConfig WHERE ConfigurationFilter = 'FactOrders')&#xA;    UPDATE dbo.PackageConfig &#xA;    SET ConfiguredValue = ? &#xA;    WHERE ConfigurationFilter = 'FactOrders';&#xA;ELSE&#xA;    INSERT INTO dbo.PackageConfig (ConfigurationFilter, ConfiguredValue, PackagePath, ConfiguredValueType) &#xA;    VALUES ('FactOrders', ?, '\Package\FactOrders.dtsx', 'Int64');" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
