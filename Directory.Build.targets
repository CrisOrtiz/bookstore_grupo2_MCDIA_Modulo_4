<Project>
  <!-- Auto-generate local ETL connection managers before building the ETL project. -->
  <Target Name="GenerateEtlConnectionManagersBeforeBuild"
          BeforeTargets="Build"
          Condition="'$(MSBuildProjectExtension)' == '.dtproj' and '$(MSBuildProjectName)' == 'Bookstore_ETL'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\Generate-ConnectionManagers.ps1&quot;" />
  </Target>
</Project>
